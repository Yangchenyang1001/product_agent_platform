# 页面标题
VITE_APP_TITLE = 若依管理系统

# 开发环境配置
VITE_APP_ENV = 'development'

# 若依管理系统/开发环境
VITE_APP_BASE_API = '/dev-api'

# 外部知识库导入服务（本地联调示例：http://127.0.0.1:8000）
# 未配置时知识导入页面会禁用文件上传
VITE_APP_KNOWLEDGE_IMPORT_API_BASE = 'http://127.0.0.1:8000'

# 外部知识库查询服务（浏览器直连，需要外部服务允许当前前端域名跨域访问）
VITE_APP_KNOWLEDGE_QUERY_API_BASE = 'http://127.0.0.1:8000'
