# 页面标题
VITE_APP_TITLE = 若依管理系统

# 生产环境配置
VITE_APP_ENV = 'staging'

# 若依管理系统/生产环境
VITE_APP_BASE_API = '/stage-api'

# 外部知识库导入服务，由预发部署环境注入
VITE_APP_KNOWLEDGE_IMPORT_API_BASE = 'http://127.0.0.1:8000'

# 外部知识库查询服务，由预发部署环境注入
VITE_APP_KNOWLEDGE_QUERY_API_BASE = 'http://127.0.0.1:8001'

# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip
